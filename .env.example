# =============================================================================
# CMPRSSN Signal Agent — Environment Configuration
# =============================================================================
# Copy this file to .env (in the repo root, NOT inside agent/) and fill in
# every REQUIRED value. Run `python agent/scripts/setup_wizard.py` for a guided
# walkthrough that writes this file for you.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Telegram
# -----------------------------------------------------------------------------
# Create a bot at https://t.me/BotFather → /newbot → save the token
TELEGRAM_CMPRSSN_BOT_TOKEN=

# Chat ID of your supergroup (negative number prefixed with -100…).
# Easiest way to find: add @RawDataBot to the group, copy the chat.id from its
# message, then remove @RawDataBot.
TELEGRAM_CMPRSSN_CHAT_ID=

# Topic / forum thread IDs. Open each topic in a desktop client; URL is
# t.me/c/<chat>/<TOPIC_ID>/<msg>. Use that TOPIC_ID here.
TELEGRAM_CMPRSSN_TOPIC_PULSE=
TELEGRAM_CMPRSSN_TOPIC_COMPRESSION=
TELEGRAM_CMPRSSN_TOPIC_CODEBOOK=
TELEGRAM_CMPRSSN_TOPIC_FRONTIER=
TELEGRAM_CMPRSSN_TOPIC_ONCHAIN=

# General topic = 0 (means "no thread, post to main chat" — Telegram quirk).
# Override only if you set up a custom General-equivalent thread.
TELEGRAM_CMPRSSN_TOPIC_GENERAL=0

# -----------------------------------------------------------------------------
# REQUIRED — X (Twitter) API v2
# -----------------------------------------------------------------------------
# Get a bearer token at https://developer.x.com/ (credits-based pay-as-you-go).
# $10 lasts a long time at 4 polls/day across ~100 handles.
TWITTER_BEARER_TOKEN=

# Optional bookkeeping — only used in log messages
TWITTER_ACCOUNT_ID=
TWITTER_BILLING_URL=https://console.x.com/

# -----------------------------------------------------------------------------
# REQUIRED — Bluesky (AT Protocol)
# -----------------------------------------------------------------------------
# Use a real account email + an APP PASSWORD (NOT your account password).
# Generate at https://bsky.app/settings/app-passwords
BLUESKY_EMAIL=
BLUESKY_APP_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL — Runtime tunables (overrides defaults baked into the agent)
# -----------------------------------------------------------------------------
# Qualitative gate threshold. Posts scoring below this are dropped.
# Range 0–10. Default 6. Raise to 7–8 to be stricter; lower to 4–5 for more volume.
MIN_QUAL_SCORE=6

# Per-run publish caps. Prevents burst spam in a single scheduled run.
MAX_POSTS_PER_RUN=15
MAX_POSTS_PER_TOPIC_PER_RUN=5

# Quant gate (engagement) thresholds — only applied to X / Bluesky posts.
# RSS posts auto-pass since they have no engagement metrics.
MIN_LIKES_FLOOR=25
MIN_LIKES_FLOOR_TIER3=10
ENGAGEMENT_RATIO_MIN=0.001

# Per-handle fetch limits per poll
TWEETS_PER_HANDLE=10
RSS_MAX_ENTRIES=5
RSS_MAX_AGE_DAYS=3

# Claude CLI path — change if `claude` is not on $PATH
CLAUDE_CMD=claude
CLAUDE_TIMEOUT_S=60
